#!/usr/bin/env bash
# ==============================================================================
# Ori - Tiling Window Launcher for i3wm Rice
# ==============================================================================

set -e
export PATH="$HOME/.local/bin:$PATH"
export OLLAMA_HOST="${OLLAMA_HOST:-http://127.0.0.1:11434}"

# Execute Ori GUI directly (i3 tiles windows with class Ori automatically)
exec "$HOME/.local/bin/ori" "$@"
