#!/usr/bin/env bash
# ==============================================================================
# DesktopConfigs Sync & Multi-Device Manager
# Easily manage, sync, and deploy your dotfiles across all your Linux devices.
# ==============================================================================

set -e

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

RED='\033[38;2;243;139;168m'
GREEN='\033[38;2;166;227;161m'
BLUE='\033[38;2;137;180;250m'
YELLOW='\033[38;2;249;226;175m'
PEACH='\033[38;2;250;179;135m'
MAUVE='\033[38;2;203;166;247m'
TEAL='\033[38;2;148;226;213m'
SUBTEXT='\033[38;2;166;173;200m'
BOLD='\033[1m'
NC='\033[0m' # No Color

notify() {
    local title="$1"
    local body="$2"
    local urgency="${3:-normal}"
    if command -v dunstify >/dev/null 2>&1 && [ -n "$DISPLAY" ]; then
        dunstify -r 7788 -u "$urgency" -h string:x-dunst-stack-tag:dotfiles "$title" "$body"
    fi
}

# ------------------------------------------------------------------------------
# PULL: Update from Git and reload desktop
# ------------------------------------------------------------------------------
do_pull() {
    echo -e "${BLUE}${BOLD}==> Checking for updates from GitHub...${NC}"
    cd "$DOTFILES_DIR"

    # Fetch and check
    git fetch origin main

    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)

    if [ "$LOCAL" = "$REMOTE" ]; then
        if [ "$1" = "-f" ] || [ "$1" = "--force" ]; then
            echo -e "${BLUE}==> Local repository is up to date. Force re-applying configurations to desktop...${NC}"
        else
            echo -e "${GREEN}==> Already up to date with origin/main.${NC}"
            echo -e "Use 'dotfiles pull --force' to re-deploy local configs."
            return 0
        fi
    else
        echo -e "${BLUE}==> Pulling latest changes...${NC}"
        git pull origin main
    fi

    echo -e "${BLUE}==> Deploying updated configurations to ~/.config/...${NC}"
    mkdir -p "$HOME/.config"
    cp -r "$DOTFILES_DIR/config/"* "$HOME/.config/"

    # Wallpapers
    mkdir -p "$HOME/Pictures/Wallpapers"
    cp -r "$DOTFILES_DIR/wallpapers/"* "$HOME/Pictures/Wallpapers/"

    # Icons & Desktop Applications
    if [ -d "$DOTFILES_DIR/icons" ]; then
        mkdir -p "$HOME/.local/share/icons/hicolor/scalable/apps"
        cp -r "$DOTFILES_DIR/icons/"* "$HOME/.local/share/icons/" 2>/dev/null || true
        cp -r "$DOTFILES_DIR/icons/"*.svg "$HOME/.local/share/icons/hicolor/scalable/apps/" 2>/dev/null || true
        command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
    fi

    if [ -d "$DOTFILES_DIR/applications" ]; then
        mkdir -p "$HOME/.local/share/applications"
        cp -r "$DOTFILES_DIR/applications/"* "$HOME/.local/share/applications/" 2>/dev/null || true
    fi

    # Home dotfiles & Xresources
    [ -f "$DOTFILES_DIR/home/.nanorc" ] && cp "$DOTFILES_DIR/home/.nanorc" "$HOME/.nanorc"
    [ -f "$DOTFILES_DIR/home/.xinputrc" ] && cp "$DOTFILES_DIR/home/.xinputrc" "$HOME/.xinputrc"
    [ -f "$DOTFILES_DIR/home/.xinitrc" ] && { cp "$DOTFILES_DIR/home/.xinitrc" "$HOME/.xinitrc"; chmod +x "$HOME/.xinitrc" 2>/dev/null || true; }
    if [ -f "$DOTFILES_DIR/Xresources" ]; then
        cp "$DOTFILES_DIR/Xresources" "$HOME/.Xresources"
        xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
    fi

    # Shell environment (~/.bashrc) - safe & non-destructive
    if [ ! -f "$HOME/.bashrc" ] && [ -f "$DOTFILES_DIR/home/.bashrc" ]; then
        cp "$DOTFILES_DIR/home/.bashrc" "$HOME/.bashrc"
    elif [ -f "$HOME/.bashrc" ]; then
        if ! grep -q '\.local/bin' "$HOME/.bashrc"; then
            echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
        fi
        if ! grep -q "Modern Terminal Rice" "$HOME/.bashrc" && [ -f "$DOTFILES_DIR/home/.bashrc" ]; then
            echo -e "${BLUE}==> Integrating Modern Terminal Rice into ~/.bashrc...${NC}"
            cat "$DOTFILES_DIR/home/.bashrc" >> "$HOME/.bashrc"
        fi
    fi

    # Ensure executable permissions and link CLI helper scripts
    mkdir -p "$HOME/.local/bin"
    for script in "$DOTFILES_DIR/scripts/"*; do
        if [ -f "$script" ]; then
            chmod +x "$script" 2>/dev/null || true
            ln -sf "$script" "$HOME/.local/bin/$(basename "$script")"
        fi
    done
    [ -f "$HOME/.config/rofi/shortcuts.py" ] && ln -sf "$HOME/.config/rofi/shortcuts.py" "$HOME/.local/bin/shortcuts-manager"

    chmod +x "$HOME/.config/polybar/launch.sh" 2>/dev/null || true
    chmod +x "$HOME/.config/polybar/scripts/"*.sh 2>/dev/null || true
    chmod +x "$HOME/.config/dunst/launch.sh" 2>/dev/null || true
    chmod +x "$HOME/.config/dunst/scripts/"*.sh 2>/dev/null || true
    chmod +x "$HOME/.config/rofi/"*.sh "$HOME/.config/rofi/"*.py 2>/dev/null || true
    chmod +x "$HOME/.config/theme/apply-theme.sh" 2>/dev/null || true
    chmod +x "$HOME/.config/i3/screenshot.sh" "$HOME/.config/i3/lock.sh" 2>/dev/null || true
    chmod +x "$HOME/.config/zen/setup-zen.sh" 2>/dev/null || true

    # Auto-install, configure, and customize Zen Browser
    if [ -x "$HOME/.config/zen/setup-zen.sh" ]; then
        echo -e "${BLUE}==> Auto-checking, installing, and configuring Zen Browser...${NC}"
        "$HOME/.config/zen/setup-zen.sh" || true
    fi

    # Ensure visual password feedback (asterisks) in console
    if [ ! -f /etc/sudoers.d/01_pwfeedback ] && [ -f "$DOTFILES_DIR/etc/sudoers.d/01_pwfeedback" ]; then
        if sudo -n true 2>/dev/null; then
            sudo mkdir -p /etc/sudoers.d
            sudo cp "$DOTFILES_DIR/etc/sudoers.d/01_pwfeedback" /etc/sudoers.d/01_pwfeedback
            sudo chmod 0440 /etc/sudoers.d/01_pwfeedback
            sudo visudo -c >/dev/null 2>&1 || sudo rm -f /etc/sudoers.d/01_pwfeedback
        fi
    fi

    # Hot-reload desktop environment if running inside X11
    if [ -n "$DISPLAY" ]; then
        echo -e "${BLUE}==> Reloading desktop environment components...${NC}"
        # Reload i3
        i3-msg reload >/dev/null 2>&1 || true
        # Relaunch Polybar
        "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 || true
        # Reload Dunst
        dunstctl reload >/dev/null 2>&1 || true
        # Reload xsettingsd
        if command -v xsettingsd >/dev/null 2>&1; then
            pkill xsettingsd 2>/dev/null || true
            xsettingsd &
        fi
        # Restart Picom compositor
        pkill picom 2>/dev/null || true
        sleep 0.1
        picom -b --config "$HOME/.config/picom/picom.conf" 2>/dev/null || true
        # Re-apply theme to active wallpaper
        if [ -f "$HOME/.fehbg" ]; then
            "$HOME/.fehbg" >/dev/null 2>&1 || true
        fi
    fi

    # Check for missing recommended packages
    MISSING_PKGS=()
    for pkg in fastfetch starship eza bat fzf zoxide xss-lock i3lock; do
        if ! command -v "$pkg" >/dev/null 2>&1; then
            MISSING_PKGS+=("$pkg")
        fi
    done
    if [ ${#MISSING_PKGS[@]} -gt 0 ]; then
        echo -e "\n  ${YELLOW}ℹ Detected missing recommended packages: ${MISSING_PKGS[*]}${NC}"
        echo -e "    Run '${TEAL}update-desktop --install${NC}' or '${TEAL}dotfiles install${NC}' to install them automatically."
    fi

    echo -e "${GREEN}${BOLD}✔ Successfully updated and hot-reloaded desktop configurations!${NC}"
    notify "󰊤 Dotfiles Updated" "Successfully pulled and applied latest changes from GitHub."
}

# ------------------------------------------------------------------------------
# PUSH: Collect local configs, commit, and push to Git
# ------------------------------------------------------------------------------
do_push() {
    local message="${1:-Update desktop configurations and theme}"
    echo -e "${BLUE}${BOLD}==> Collecting local configurations from ~/.config/...${NC}"
    cd "$DOTFILES_DIR"

    # Sync changed configs into dotfiles repo (including consoles, utilities, apps, gaming, custom themes)
    for dir in alacritty autostart bat btop dunst dxvk environment.d fastfetch gtk-3.0 gtk-4.0 i3 ly MangoHud openrgb ori picom polybar rofi systemd theme zen Thunar xfce4 xsettingsd; do
        if [ -d "$HOME/.config/$dir" ]; then
            mkdir -p "$DOTFILES_DIR/config/$dir"
            cp -a "$HOME/.config/$dir/"* "$DOTFILES_DIR/config/$dir/" 2>/dev/null || true
        fi
    done

    # Clean any __pycache__
    rm -rf "$DOTFILES_DIR/config/rofi/__pycache__"

    # Sync single configuration files
    [ -f "$HOME/.config/starship.toml" ] && cp "$HOME/.config/starship.toml" "$DOTFILES_DIR/config/starship.toml"

    # Sync custom icons & desktop applications
    if [ -d "$HOME/.local/share/icons" ]; then
        mkdir -p "$DOTFILES_DIR/icons"
        [ -f "$HOME/.local/share/icons/ori.svg" ] && cp "$HOME/.local/share/icons/ori.svg" "$DOTFILES_DIR/icons/ori.svg"
    fi

    if [ -d "$HOME/.local/share/applications" ]; then
        mkdir -p "$DOTFILES_DIR/applications"
        for app in ori.desktop wallpaper-picker.desktop; do
            [ -f "$HOME/.local/share/applications/$app" ] && cp "$HOME/.local/share/applications/$app" "$DOTFILES_DIR/applications/$app"
        done
    fi

    # Sync wallpapers
    if [ -d "$HOME/Pictures/Wallpapers" ]; then
        mkdir -p "$DOTFILES_DIR/wallpapers"
        cp -a "$HOME/Pictures/Wallpapers/"* "$DOTFILES_DIR/wallpapers/" 2>/dev/null || true
    fi

    # Sync Xresources
    if [ -f "$HOME/.Xresources" ]; then
        cp "$HOME/.Xresources" "$DOTFILES_DIR/Xresources"
    fi

    # Note: home/.bashrc is maintained as a clean, portable reference template
    # and is not automatically overwritten by machine-specific ~/.bashrc

    # Check git status
    if [ -z "$(git status --porcelain)" ]; then
        echo -e "${GREEN}==> No changes detected. Dotfiles are already up to date.${NC}"
        return 0
    fi

    echo -e "${BLUE}==> Changes to be committed:${NC}"
    git status -s

    git add -A
    git commit -m "$message"
    echo -e "${BLUE}==> Pushing to origin main...${NC}"
    git push origin main

    echo -e "${GREEN}${BOLD}✔ Successfully pushed configurations to GitHub!${NC}"
    notify "󰊤 Dotfiles Pushed" "Changes committed and uploaded to GitHub."
}

# ------------------------------------------------------------------------------
# STATUS: Check synchronization status
# ------------------------------------------------------------------------------
do_status() {
    cd "$DOTFILES_DIR"
    echo -e "${BOLD}==> Git Remote Status:${NC}"
    git fetch origin main >/dev/null 2>&1 || true
    
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)
    BASE=$(git merge-base HEAD origin/main)

    if [ "$LOCAL" = "$REMOTE" ]; then
        echo -e "  Git Branch: ${GREEN}Up to date with origin/main${NC}"
    elif [ "$LOCAL" = "$BASE" ]; then
        echo -e "  Git Branch: ${YELLOW}Behind origin/main (run 'dotfiles pull')${NC}"
    elif [ "$REMOTE" = "$BASE" ]; then
        echo -e "  Git Branch: ${BLUE}Ahead of origin/main (run 'dotfiles push')${NC}"
    else
        echo -e "  Git Branch: ${RED}Diverged from origin/main${NC}"
    fi

    echo ""
    echo -e "${BOLD}==> Local Working Tree:${NC}"
    git status -s || echo "Clean"

    echo ""
    echo -e "${BOLD}==> Active Theme State:${NC}"
    if [ -f "$HOME/.config/theme/accent.color" ]; then
        echo -e "  Accent: $(cat "$HOME/.config/theme/accent.color")"
    fi
    if [ -f "$HOME/.config/theme/bg.color" ]; then
        echo -e "  Background: $(cat "$HOME/.config/theme/bg.color")"
    fi
}

# ------------------------------------------------------------------------------
# HELP
# ------------------------------------------------------------------------------
do_help() {
    echo -e "${BOLD}DesktopConfigs Manager${NC} (Catppuccin Mocha Rice)

${BOLD}USAGE:${NC}
  dotfiles <command> [arguments]

${BOLD}COMMANDS:${NC}
  ${GREEN}pull${NC} [--force]      Pull latest configs from GitHub and hot-reload desktop live
  ${GREEN}push${NC} [message]      Sync local ~/.config changes, commit, and push to GitHub
  ${GREEN}status${NC}              Show synchronization status between local machine and Git
  ${GREEN}diff${NC}                Show uncommitted changes in the dotfiles repository
  ${GREEN}install [options]${NC}   Run the full system installer (packages & setup)
  ${GREEN}help${NC}                Display this help cheat-sheet

${BOLD}SHORTCUTS:${NC}
  ${TEAL}update-desktop${NC}            Pull latest changes & reload desktop components
  ${TEAL}update-desktop --force${NC}    Force re-deploy all configurations and wallpapers
  ${TEAL}update-desktop --install${NC}  Launch the interactive system installer suite

${BOLD}MULTI-DEVICE WORKFLOW:${NC}
  • On any PC after making tweaks:
      ${BLUE}dotfiles push \"tuned polybar widgets\"${NC}

  • On your other PCs / laptop:
      ${BLUE}update-desktop${NC} or ${BLUE}dotfiles pull${NC}

  • On a brand-new PC (one-liner bootstrap):
      ${YELLOW}curl -fsSL https://raw.githubusercontent.com/GitTonda/DesktopConfigs/main/bootstrap.sh | bash${NC}
"
}

CMD_NAME=$(basename "$0")
if [ "$CMD_NAME" = "update-desktop" ] || [ "$CMD_NAME" = "desktop-update" ]; then
    if [ "$1" = "--install" ] || [ "$1" = "-i" ] || [ "$1" = "--full" ]; then
        shift
        cd "$DOTFILES_DIR" && ./install.sh "$@"
        exit 0
    elif [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
        do_help
        exit 0
    fi
    do_pull "$@"
    exit 0
fi

case "$1" in
    pull|update|sync)
        shift
        do_pull "$@"
        ;;
    push|save)
        shift
        do_push "$@"
        ;;
    status|st)
        do_status
        ;;
    diff)
        cd "$DOTFILES_DIR" && git diff
        ;;
    install)
        shift
        cd "$DOTFILES_DIR" && ./install.sh "$@"
        ;;
    help|--help|-h|"")
        do_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'dotfiles help' for usage instructions."
        exit 1
        ;;
esac
