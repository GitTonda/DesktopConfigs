# ==============================================================================
# Dunst Notification Daemon - Catppuccin Mocha Rice
# ==============================================================================

[global]
    monitor = 0
    follow = mouse
    width = 380
    height = 300
    origin = top-right
    offset = 18x55
    scale = 0
    notification_limit = 5

    # Individual Floating Cards
    gap_size = 8

    # Progress Bar (Volume, Brightness, Battery, Downloads)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 320
    progress_bar_corner_radius = 0
    highlight = "#89b4fa"

    # Frame & Geometry (Squared Aesthetic)
    frame_width = 2
    frame_color = "#89b4fa"
    separator_height = 0
    separator_color = frame
    corner_radius = 0

    # Spacing & Padding
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 14

    # Typography & Markup
    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<span font_desc='JetBrainsMono Nerd Font Bold 10.5'>%s</span>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    icon_theme = "Papirus-Dark, Adwaita, hicolor"
    enable_recursive_icon_lookup = true

    # History & Lifetime
    sticky_history = yes
    history_length = 25
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# ==============================================================================
# Urgency Profiles
# ==============================================================================

[urgency_low]
    background = "#181825"
    foreground = "#a6adc8"
    frame_color = "#313244"
    highlight = "#a6adc8"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0

# ==============================================================================
# Themed Category Rules
# ==============================================================================

[volume_osd]
    summary = "*Volume*"
    highlight = "#cba6f7"
    frame_color = "#cba6f7"
    timeout = 2

[brightness_osd]
    summary = "*Brightness*"
    highlight = "#fab387"
    frame_color = "#fab387"
    timeout = 2

[screenshot_rule]
    summary = "*Screenshot*"
    frame_color = "#a6e3a1"
    highlight = "#a6e3a1"
    timeout = 3

[network_rule]
    summary = "*Wi-Fi*"
    frame_color = "#a6e3a1"
    highlight = "#a6e3a1"
    timeout = 4

[calendar_rule]
    summary = "*Calendar*"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 5
