/**
 * Rofi System & Resource Dashboard - Catppuccin Mocha Terminal Style
 */

configuration {
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 false;
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

@import "colors.rasi"

* {
    bg-frosted:                 rgba(17, 17, 27, 0.90);
    bg-header:                  rgba(24, 24, 37, 0.85);
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    green:                      #a6e3a1;
    teal:                       #94e2d5;
    blue:                       #89b4fa;
    lavender:                   #cba6f7;
    peach:                      #fab387;
    yellow:                     #f9e2af;
    urgent:                     #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      680px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg-frosted;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 18px;
    background-color:           @bg-header;
    border:                     0px 0px 1px 0px solid;
    border-color:               @surface0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    4px 10px;
    border-radius:              0px;
    background-color:           @accent;
    text-color:                 #1e1e2e;
    font:                       "JetBrainsMono Nerd Font Bold 10";
}

entry {
    enabled:                    true;
    padding:                    4px 6px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "filter telemetry or actions...";
    placeholder-color:          @fg-dim;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      13;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    3px;
    padding:                    10px 14px;
    background-color:           transparent;
}

element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    7px 12px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element normal.active {
    background-color:           transparent;
    text-color:                 @accent;
}

element selected.normal {
    background-color:           @surface0;
    text-color:                 @accent;
    border:                     0px 0px 0px 3px solid;
    border-color:               @accent;
}

element selected.active {
    background-color:           @surface0;
    text-color:                 @accent;
    border:                     0px 0px 0px 3px solid;
    border-color:               @accent;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    font:                       "JetBrainsMono Nerd Font 10";
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
