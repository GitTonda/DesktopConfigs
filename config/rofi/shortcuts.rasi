/**
 * Rofi Shortcuts Manager - Catppuccin Mocha Terminal Style
 */

configuration {
    font:                       "JetBrainsMono Nerd Font 10.5";
    show-icons:                 false;
}

@import "colors.rasi"

* {
    bg-alt:                     #181825;
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    green:                      #a6e3a1;
    urgent:                     #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      720px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 16px;
    background-color:           @bg-alt;
    border:                     0px 0px 1px 0px solid;
    border-color:               @surface0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    4px 10px;
    border-radius:              0px;
    background-color:           @accent;
    text-color:                 #1e1e2e;
    font:                       "JetBrainsMono Nerd Font Bold 10";
}

entry {
    enabled:                    true;
    padding:                    4px 6px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Cerca scorciatoia o azione...";
    placeholder-color:          @fg-dim;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      12;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    2px;
    padding:                    8px 10px;
    background-color:           @bg;
}

element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    8px 12px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
}

element selected.normal {
    background-color:           @surface0;
    text-color:                 @accent;
    border:                     0px 0px 0px 3px solid;
    border-color:               @accent;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    font:                       "JetBrainsMono Nerd Font 10.5";
}
