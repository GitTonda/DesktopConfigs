/**
 * Rofi Modern Application Launcher - Catppuccin Mocha Grid
 * Enhanced with High-Contrast Card Tiles, Hover-Select, Dual-Kawase Blur, and Papirus Icons
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "󰀻 apps :~$";
    display-run:                " run :~$";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10";

    /* Mouse Hover & Click Polish */
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

@import "colors.rasi"

* {
    /* Frosted Translucent Palette with Dual-Kawase Picom Blur */
    bg-frosted:                 rgba(17, 17, 27, 0.78);
    bg-header:                  rgba(24, 24, 37, 0.72);
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    urgent:                     #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      920px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg-frosted;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 20px;
    background-color:           @bg-header;
    border:                     0px 0px 1px 0px solid;
    border-color:               @surface0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    4px 10px;
    border-radius:              0px;
    background-color:           @accent;
    text-color:                 #1e1e2e;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

entry {
    enabled:                    true;
    padding:                    4px 8px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Search applications or commands...";
    placeholder-color:          @fg-dim;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

listview {
    enabled:                    true;
    layout:                     vertical;
    flow:                       horizontal;
    columns:                    5;
    lines:                      4;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    10px;
    padding:                    16px 20px;
    border:                     0px solid;
    border-color:               transparent;
    background-color:           transparent;
    cursor:                     "default";
}

element {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    8px;
    padding:                    14px 8px;
    border:                     1px solid;
    border-color:               #ffffff22;
    border-radius:              0px;
    background-color:           #ffffff14;
    text-color:                 @fg;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           #ffffff14;
    border-color:               #ffffff22;
    text-color:                 @fg;
}

element normal.active {
    background-color:           #ffffff14;
    border-color:               @accent;
    text-color:                 @accent;
}

element normal.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element alternate.normal {
    background-color:           #ffffff14;
    border-color:               #ffffff22;
    text-color:                 @fg;
}

element alternate.active {
    background-color:           #ffffff14;
    border-color:               @accent;
    text-color:                 @accent;
}

element alternate.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element selected.normal {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.active {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       44px;
    cursor:                     inherit;
    horizontal-align:           0.5;
    vertical-align:             0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    font:                       "JetBrainsMono Nerd Font 9";
}
