/**
 * Rofi Application Launcher - Catppuccin Mocha Grid Style
 * Cohesive with all other menus (wifi, bluetooth, powermenu, shortcuts)
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "󰀻 apps :~$";
    display-run:                " run :~$";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10.5";
}

@import "colors.rasi"

* {
    bg-alt:                     #181825;
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    urgent:                     #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      780px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 18px;
    background-color:           @bg-alt;
    border:                     0px 0px 1px 0px solid;
    border-color:               @surface0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    4px 10px;
    border-radius:              0px;
    background-color:           @accent;
    text-color:                 #1e1e2e;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

entry {
    enabled:                    true;
    padding:                    4px 6px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Cerca applicazioni o comandi...";
    placeholder-color:          @fg-dim;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

listview {
    enabled:                    true;
    layout:                     vertical;
    flow:                       horizontal;
    columns:                    5;
    lines:                      4;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    8px;
    padding:                    14px 16px;
    border:                     0px solid;
    border-color:               transparent;
    background-color:           transparent;
    cursor:                     "default";
}

element {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    8px;
    padding:                    12px 6px;
    border:                     2px solid;
    border-color:               transparent;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    border-color:               transparent;
    text-color:                 @fg;
}

element normal.active {
    background-color:           transparent;
    border-color:               @surface0;
    text-color:                 @accent;
}

element normal.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element alternate.normal {
    background-color:           transparent;
    border-color:               transparent;
    text-color:                 @fg;
}

element alternate.active {
    background-color:           transparent;
    border-color:               @surface0;
    text-color:                 @accent;
}

element alternate.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element selected.normal {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.active {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.urgent {
    background-color:           @urgent;
    text-color:                 #1e1e2e;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       40px;
    cursor:                     inherit;
    horizontal-align:           0.5;
    vertical-align:             0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    font:                       "JetBrainsMono Nerd Font 10";
}
