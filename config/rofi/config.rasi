/**
 * Rofi Modern Grid Application Launcher
 * Catppuccin Mocha Clean Minimal Grid
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "󰍉";
    display-run:                "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10.5";
}

@import "colors.rasi"

* {
    bg-base:                    #11111b;
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    urgent:                     #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      880px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg;
    cursor:                     "default";
    padding:                    24px;
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    12px 18px;
    margin:                     0px 0px 20px 0px;
    background-color:           #181825;
    border:                     1px solid;
    border-color:               @surface0;
    border-radius:              0px;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    2px 0px 0px 0px;
    background-color:           transparent;
    text-color:                 @accent;
    font:                       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled:                    true;
    padding:                    2px 0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Cerca applicazioni...";
    placeholder-color:          @fg-dim;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

listview {
    enabled:                    true;
    columns:                    5;
    lines:                      4;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    12px;
    padding:                    0px;
    border:                     0px solid;
    border-color:               transparent;
    background-color:           transparent;
    cursor:                     "default";
}

element {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    8px;
    padding:                    14px 8px;
    border:                     1px solid;
    border-color:               #31324440;
    border-radius:              0px;
    background-color:           #18182560;
    text-color:                 @fg;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           #18182560;
    border-color:               #31324440;
    text-color:                 @fg;
}

element normal.active {
    background-color:           #18182560;
    border-color:               @accent;
    text-color:                 @accent;
}

element normal.urgent {
    background-color:           @urgent;
    text-color:                 @bg-base;
}

element alternate.normal {
    background-color:           #18182560;
    border-color:               #31324440;
    text-color:                 @fg;
}

element alternate.active {
    background-color:           #18182560;
    border-color:               @accent;
    text-color:                 @accent;
}

element alternate.urgent {
    background-color:           @urgent;
    text-color:                 @bg-base;
}

element selected.normal {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.active {
    background-color:           @surface0;
    border-color:               @accent;
    text-color:                 @accent;
}

element selected.urgent {
    background-color:           @urgent;
    text-color:                 @bg-base;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       42px;
    cursor:                     inherit;
    horizontal-align:           0.5;
    vertical-align:             0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    font:                       "JetBrainsMono Nerd Font 10";
}
