/**
 * Powermenu Theme - Terminal TUI Vibe
 */

@import "colors.rasi"

* {
    bg:                         #1e1e2e;
    bg-alt:                     #181825;
    surface0:                   #313244;
    surface1:                   #45475a;
    fg:                         #cdd6f4;
    fg-dim:                     #6c7086;
    red:                        #f38ba8;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      560px;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              0px;
    background-color:           @bg;
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    padding:                    0px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    14px 18px;
    background-color:           @bg-alt;
    border:                     0px 0px 1px 0px solid;
    border-color:               @surface0;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    padding:                    4px 10px;
    border-radius:              0px;
    background-color:           @accent;
    text-color:                 #1e1e2e;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

entry {
    enabled:                    true;
    padding:                    4px 8px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    placeholder:                "key [1-4] or search...";
    placeholder-color:          @fg-dim;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      4;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    4px;
    padding:                    10px 12px;
    background-color:           @bg;
}

element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 14px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
}

element selected.normal {
    background-color:           @surface0;
    text-color:                 @accent;
    border:                     0px 0px 0px 3px solid;
    border-color:               @accent;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}
