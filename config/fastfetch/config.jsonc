{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": {
            "1": "cyan",
            "2": "cyan"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "{#90}┌───────────┐{#}",
            "type": "custom"
        },
        {
            "key": "{#90}│{#} {#38;2;255;170;69} user    {#90}│{#}",
            "type": "title",
            "format": "{user-name}{at-symbol-colored}{host-name}"
        },
        {
            "key": "{#90}│{#} {#34}󰣇 distro  {#90}│{#}",
            "type": "os",
            "format": "{name} {arch}"
        },
        {
            "key": "{#90}│{#} {#33} kernel  {#90}│{#}",
            "type": "kernel",
            "format": "{release}"
        },
        {
            "key": "{#90}│{#} {#32}󰅐 uptime  {#90}│{#}",
            "type": "uptime"
        },
        {
            "key": "{#90}│{#} {#33}󰏖 pkgs    {#90}│{#}",
            "type": "packages"
        },
        {
            "key": "{#90}│{#} {#35} wm      {#90}│{#}",
            "type": "wm"
        },
        {
            "key": "{#90}│{#} {#31} term    {#90}│{#}",
            "type": "terminal"
        },
        {
            "key": "{#90}│{#} {#36} shell   {#90}│{#}",
            "type": "shell"
        },
        {
            "key": "{#90}│{#} {#36} cpu     {#90}│{#}",
            "type": "cpu",
            "format": "{name}"
        },
        {
            "key": "{#90}│{#} {#34}󰾲 gpu     {#90}│{#}",
            "type": "gpu",
            "format": "{name}"
        },
        {
            "key": "{#90}│{#} {#32} memory  {#90}│{#}",
            "type": "memory"
        },
        {
            "key": "{#90}│{#} {#33}󰉉 disk    {#90}│{#}",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#90}├───────────┤{#}",
            "type": "custom"
        },
        {
            "key": "{#90}│{#} {#37} colors  {#90}│{#}",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "{#90}└───────────┘{#}",
            "type": "custom"
        }
    ]
}
