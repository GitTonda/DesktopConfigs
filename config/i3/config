# ==============================================================================
# i3 Configuration - Modern Minimal Rice
# ==============================================================================

# Modifier key: Super (Windows key)
set $mod Mod4

# Font for window titles & fallback
font pango:JetBrainsMono Nerd Font 10

# Drag windows using Super + Left Click
floating_modifier $mod

# ==============================================================================
# Gaps & Borders (Native in i3 >= 4.22)
# ==============================================================================
gaps inner 5
gaps outer 2

default_border pixel 2
default_floating_border pixel 2

# Enforce border on all windows
for_window [class="^.*"] border pixel 2

# Prevent dialogs, popups, and tray applets from tiling as full windows
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="notification"] floating enable
for_window [class="(?i)nm-applet"] floating enable
for_window [class="(?i)nm-connection-editor"] floating enable
for_window [class="(?i)blueman"] floating enable
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="(?i)ibus.*"] floating enable
for_window [title="(?i)ibus.*"] floating enable
for_window [class="File-roller|org.gnome.FileRoller"] floating enable, move position center
for_window [class="FloatingTerm|FloatingBtop|FloatingGPU|FloatingAudio|FloatingWifi|FloatingBluetooth"] floating enable, resize set 950 620, move position center
for_window [class="(?i)control_center.*|ControlCenter"] floating enable, border none
for_window [instance="(?i)control_center.*|ControlCenter"] floating enable, border none
# Ori: main application window tiles; all dialogs, popups, and confirmation alerts float in center
for_window [class="(?i)ori" window_type="normal"] floating disable
for_window [class="(?i)ori" window_type="dialog"] floating enable, move position center
for_window [class="(?i)ori" window_role="dialog"] floating enable, move position center
for_window [class="(?i)ori" window_role="pop-up"] floating enable, move position center
for_window [class="(?i)ori" title="^Ori - (Real-Time|Settings|Shared|Confirm)"] floating enable, move position center
for_window [class="(?i)ori" title="^(?!Ori - Local AI Assistant$).*"] floating enable, move position center
for_window [instance="localhost"] floating disable
for_window [title="(?i)Langflow"] floating disable
for_window [class="(?i)min"] floating disable

# ==============================================================================
# Color Palette - Catppuccin Mocha Minimal (Dynamic Wallpaper Accent)
# ==============================================================================
include ~/.config/i3/colors.conf

# ==============================================================================
# Keybindings - Core
# ==============================================================================
# Launch terminal (Alacritty)
bindsym $mod+Return exec --no-startup-id alacritty

# Launch web browser (Zen)
bindsym $mod+F2 exec --no-startup-id zen-browser
bindsym $mod+Ctrl+b exec --no-startup-id zen-browser

# Launch Ori Local AI Assistant (Floating or Fullscreen)
bindsym $mod+F3 exec --no-startup-id ~/.local/bin/ori-window
bindsym $mod+Shift+F3 exec --no-startup-id ~/.local/bin/ori-window --fullscreen
bindsym $mod+Ctrl+o exec --no-startup-id ~/.local/bin/ori-window
bindsym $mod+Ctrl+Shift+o exec --no-startup-id ~/.local/bin/ori-window --fullscreen

# Launch file manager (Thunar)
bindsym $mod+Shift+Return exec --no-startup-id thunar
bindsym $mod+Shift+f exec --no-startup-id thunar

# Lock screen manually ($mod+Ctrl+l or XF86ScreenSaver)
bindsym $mod+Ctrl+l exec --no-startup-id ~/.config/i3/lock.sh
bindsym XF86ScreenSaver exec --no-startup-id ~/.config/i3/lock.sh

# Launch system monitor (Rofi System Dashboard / Btop)
bindsym $mod+Shift+m exec --no-startup-id ~/.config/rofi/system.sh
bindsym $mod+Ctrl+m exec --no-startup-id alacritty --class FloatingBtop -e btop

# Launch GPU monitor & dashboard (Rofi / nvitop)
bindsym $mod+Shift+g exec --no-startup-id ~/.config/rofi/gpu.sh

# Quick applet keybindings
bindsym $mod+Shift+w exec --no-startup-id ~/.config/rofi/wifi.sh
bindsym $mod+Shift+t exec --no-startup-id ~/.config/rofi/bluetooth.sh
bindsym $mod+Shift+a exec --no-startup-id ~/.config/rofi/volume.sh
bindsym $mod+Ctrl+a exec --no-startup-id alacritty --class FloatingAudio -e alsamixer
bindsym $mod+Shift+b exec --no-startup-id ~/.config/rofi/wallpaper.sh
bindsym $mod+Shift+o exec --no-startup-id ~/.config/rofi/rgb.sh
bindsym $mod+Shift+x exec --no-startup-id ~/.config/rofi/cursor.sh
bindsym $mod+Shift+p exec --no-startup-id ~/.config/polybar/launch.sh
bindsym $mod+F1 exec --no-startup-id ~/.config/rofi/shortcuts.sh
bindsym $mod+slash exec --no-startup-id ~/.config/rofi/shortcuts.sh

# Unified Control Center (Super + Shift + S)
bindsym $mod+Shift+s exec --no-startup-id ~/.config/control-center/toggle.sh

# Window Switcher (Super + Tab and Alt + Tab)
bindsym $mod+Tab exec --no-startup-id rofi -show window -theme ~/.config/rofi/window.rasi
bindsym Mod1+Tab exec --no-startup-id rofi -show window -theme ~/.config/rofi/window.rasi

# Clipboard Manager (Super + Shift + V)
bindsym $mod+Shift+v exec --no-startup-id ~/.config/rofi/clipboard.sh

# Launch application launcher (Rofi)
bindsym $mod+d exec --no-startup-id rofi -show drun

# Kill focused window (Super + Q)
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Fullscreen toggle
bindsym $mod+f fullscreen toggle

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Switch focus between tiling and floating
bindsym $mod+space focus mode_toggle

# Change split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Focus parent / child
bindsym $mod+a focus parent
# bindsym $mod+d focus child

# Reload / Restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Power Menu (Shutdown, Reboot, Suspend, Logout)
bindsym $mod+Shift+e exec --no-startup-id ~/.config/rofi/powermenu.sh
bindsym $mod+Escape exec --no-startup-id ~/.config/rofi/powermenu.sh

# ==============================================================================
# Window Navigation
# ==============================================================================
# Arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Vim keys
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ==============================================================================
# Workspaces
# ==============================================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ==============================================================================
# Resize Mode
# ==============================================================================
mode "resize" {
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# Audio, Media & Brightness Controls
# ==============================================================================
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/dunst/scripts/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/dunst/scripts/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/dunst/scripts/volume-osd.sh mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/dunst/scripts/brightness-osd.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/dunst/scripts/brightness-osd.sh down

# ==============================================================================
# Screenshots (Crop & Copy directly to Clipboard)
# ==============================================================================
# Crop selection -> Clipboard (Print, F13, XF86Tools, or Super+Shift+s)
# --release is critical for interactive selection so maim can grab pointer
bindsym --release Print exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release F13 exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release XF86Tools exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release $mod+Shift+s exec --no-startup-id ~/.config/i3/screenshot.sh

# Fullscreen -> Clipboard (Shift+Print)
bindsym --release Shift+Print exec --no-startup-id ~/.config/i3/screenshot.sh full

# ==============================================================================
# Autostart Applications
# ==============================================================================
# Launch Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id xsettingsd

# Synchronously merge Xresources, apply wallpaper, and lock desktop root cursor
exec_always --no-startup-id bash -c 'xrdb -merge ~/.Xresources && ~/.fehbg'

# Map F13 keycodes in X11 (evdev 183 -> X11 keycode 191/183)
exec_always --no-startup-id xmodmap -e "keycode 183 = F13" -e "keycode 191 = F13"

# Compositor (Picom)
exec --no-startup-id picom -b

# Notification daemon (Dynamic DPI & Gap Detection)
exec_always --no-startup-id ~/.config/dunst/launch.sh

# Idle screen saver & automatic lock management
# Timeout: 10m screensaver (600s), DPMS standby 15m (900s), suspend 20m (1200s), off 30m (1800s)
exec_always --no-startup-id xset s 600 600 +dpms dpms 900 1200 1800
exec_always --no-startup-id bash -c 'pgrep -x xss-lock >/dev/null || xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh'
exec_always --no-startup-id bash -c 'pgrep -f clip_daemon.py >/dev/null || python3 ~/.config/rofi/clip_daemon.py'

# ==============================================================================
# Custom User Shortcuts
# ==============================================================================
include ~/.config/i3/custom_shortcuts.conf
