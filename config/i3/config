# ==============================================================================
# i3 Configuration - Modern Minimal Rice
# ==============================================================================

# Modifier key: Super (Windows key)
set $mod Mod4

# Font for window titles & fallback
font pango:JetBrainsMono Nerd Font 10

# Drag windows using Super + Left Click
floating_modifier $mod

# ==============================================================================
# Gaps & Borders (Native in i3 >= 4.22)
# ==============================================================================
gaps inner 5
gaps outer 2

default_border pixel 3
default_floating_border pixel 3

# Enforce border on all windows
for_window [class="^.*"] border pixel 3

# Prevent dialogs, popups, and tray applets from tiling as full windows
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="notification"] floating enable
for_window [class="(?i)nm-applet"] floating enable
for_window [class="(?i)nm-connection-editor"] floating enable
for_window [class="(?i)blueman"] floating enable
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="(?i)ibus.*"] floating enable
for_window [title="(?i)ibus.*"] floating enable

# ==============================================================================
# Color Palette - Catppuccin Mocha Minimal
# ==============================================================================
# class                 border  bground text    indicator child_border
client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa   #89b4fa
client.focused_inactive #313244 #181825 #a6adc8 #313244   #313244
client.unfocused        #1e1e2e #11111b #6c7086 #181825   #181825
client.urgent           #f38ba8 #1e1e2e #f38ba8 #f38ba8   #f38ba8
client.placeholder      #181825 #11111b #cdd6f4 #181825   #181825
client.background       #11111b

# ==============================================================================
# Keybindings - Core
# ==============================================================================
# Launch terminal (Alacritty)
bindsym $mod+Return exec alacritty

# Launch file manager (Ranger)
bindsym $mod+Shift+Return exec alacritty -e ranger

# Launch system monitor (Btop)
bindsym $mod+Shift+m exec alacritty -e btop

# Launch application launcher (Rofi)
bindsym $mod+d exec rofi -show drun

# Kill focused window (Super + Q)
bindsym $mod+q kill
bindsym $mod+Shift+q kill

# Fullscreen toggle
bindsym $mod+f fullscreen toggle

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Switch focus between tiling and floating
bindsym $mod+space focus mode_toggle

# Change split orientation
bindsym $mod+b split h
bindsym $mod+v split v

# Change container layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Focus parent / child
bindsym $mod+a focus parent
# bindsym $mod+d focus child

# Reload / Restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Power Menu (Shutdown, Reboot, Suspend, Logout)
bindsym $mod+Shift+e exec ~/.config/rofi/powermenu.sh
bindsym $mod+Escape exec ~/.config/rofi/powermenu.sh

# ==============================================================================
# Window Navigation
# ==============================================================================
# Arrow keys
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Vim keys
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ==============================================================================
# Workspaces
# ==============================================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ==============================================================================
# Resize Mode
# ==============================================================================
mode "resize" {
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# Audio, Media & Brightness Controls
# ==============================================================================
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# ==============================================================================
# Screenshots (Crop & Copy directly to Clipboard)
# ==============================================================================
# Crop selection -> Clipboard (Print, F13, XF86Tools, or Super+Shift+s)
# --release is critical for interactive selection so maim can grab pointer
bindsym --release Print exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release F13 exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release XF86Tools exec --no-startup-id ~/.config/i3/screenshot.sh
bindsym --release $mod+Shift+s exec --no-startup-id ~/.config/i3/screenshot.sh

# Fullscreen -> Clipboard (Shift+Print)
bindsym --release Shift+Print exec --no-startup-id ~/.config/i3/screenshot.sh full

# ==============================================================================
# Autostart Applications
# ==============================================================================
# Launch Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Map F13 keycodes in X11 (evdev 183 -> X11 keycode 191/183)
exec_always --no-startup-id xmodmap -e "keycode 183 = F13" -e "keycode 191 = F13"

# Compositor (Picom)
exec --no-startup-id picom -b

# Wallpaper (restores last selected wallpaper)
exec --no-startup-id ~/.fehbg

# Notification daemon
exec --no-startup-id dunst

# Network tray icon
exec --no-startup-id nm-applet
